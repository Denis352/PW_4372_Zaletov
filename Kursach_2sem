struct TreeNode {
    int data;
    TreeNode* left;
    TreeNode* right;

    TreeNode(int value) : data(value), left(nullptr), right(nullptr) {}
};


TreeNode* createBinaryTreeRandom(int n) {
    if (n <= 0) return nullptr;

    random_device rd;
    mt19937 gen(rd());
    uniform_int_distribution<> distrib(-99, 99);

    TreeNode* root = new TreeNode(distrib(gen));
    queue<TreeNode*> q;
    q.push(root);

    int count = 1;
    while (count < n) {
        TreeNode* current = q.front();
        q.pop();

        if (count < n) {
            current->left = new TreeNode(distrib(gen));
            q.push(current->left);
            count++;
        }
        if (count < n) {
            current->right = new TreeNode(distrib(gen));
            q.push(current->right);
            count++;
        }
    }
    return root;
}

TreeNode* createBinaryTreeFromArray(const vector<int>& arr) {
    if (arr.empty()) return nullptr;

    TreeNode* root = new TreeNode(arr[0]);
    queue<TreeNode*> q;
    q.push(root);

    int i = 1;
    while (!q.empty() && i < arr.size()) {
        TreeNode* current = q.front();
        q.pop();

        if (i < arr.size()) {
            current->left = new TreeNode(arr[i]);
            q.push(current->left);
            i++;
        }
        if (i < arr.size()) {
            current->right = new TreeNode(arr[i]);
            q.push(current->right);
            i++;
        }
    }

    return root;
}

TreeNode* createBinaryTreeFromFile(const string& filename) {
    ifstream file(filename);
    if (!file.is_open()) {
        cerr << "Couldn't open the file: " << filename << endl;
        return nullptr;
    }

    vector<int> arr;
    int num;
    while (file >> num) {
        arr.push_back(num);
    }
    file.close();

    return createBinaryTreeFromArray(arr);
}



void printBinaryTree(TreeNode* root, string indent = "", bool right = false) {
    if (root == nullptr) return;

    printBinaryTree(root->right, indent + (right ? "        " : " |      "), true);
    cout << indent << (right ? " /" : " \\") << "--> " << root->data << endl;
    printBinaryTree(root->left, indent + (right ? " |      " : "        "), false);
}

void printBinaryTreeToFile(TreeNode* root, ofstream& file, string indent = "", bool right = false) {
    if (root == nullptr) return;

    printBinaryTreeToFile(root->right, file, indent + (right ? "        " : " |      "), true);
    file << indent << (right ? " /" : " \\") << "--> " << root->data << endl;
    printBinaryTreeToFile(root->left, file, indent + (right ? " |      " : "        "), false);
}



void preorderTraversal(TreeNode* root) {
    if (root != nullptr) {
        cout << root->data << " ";
        preorderTraversal(root->left);
        preorderTraversal(root->right);
    }
}

void inorderTraversal(TreeNode* root) {
    if (root != nullptr) {
        inorderTraversal(root->left);
        cout << root->data << " ";
        inorderTraversal(root->right);
    }
}

void postorderTraversal(TreeNode* root) {
    if (root != nullptr) {
        postorderTraversal(root->left);
        postorderTraversal(root->right);
        cout << root->data << " ";
    }
}

void breadthFirstTraversal(TreeNode* root) {
    if (root == nullptr) return;

    queue<TreeNode*> q;
    q.push(root);

    while (!q.empty()) {
        TreeNode* current = q.front();
        cout << current->data << " ";
        q.pop();

        if (current->left) q.push(current->left);
        if (current->right) q.push(current->right);
    }
}


void deleteBinaryTree(TreeNode* root) {
    if (root) {
        deleteBinaryTree(root->left);
        deleteBinaryTree(root->right);
        delete root;
    }
}



    // Блок 3 -> Блок 4
    for (int i = 0; i < blockSize; ++i) {
        for (int j = 0; j < blockSize; ++j) {
            *(*(temp + (i + blockSize)) + (j + blockSize)) = *(*(A + (i + blockSize)) + j);
        }

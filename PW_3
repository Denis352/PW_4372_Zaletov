}

void printMatrix(int (*A)[cols])
{
    for (int i = 0; i < rows; ++i)
    {
        for (int j = 0; j < cols; ++j)
        {
            cout << *(*(A + i) + j) << " ";
        }
        cout << endl;
    }
}

void insertionSort(int (*A)[cols]) {
    for (int i = 0; i < rows; ++i) {
        for (int j = 1; j < cols; ++j) {
            int key = *(*(A + i) + j);
            int k = j - 1;

            // Перемещаем элементы arr[i][0..j-1], которые больше ключа,
            // на одну позицию вперед от их текущей позиции
            while (k >= 0 && *(*(A + i) + k) > key) {
                *(*(A + i) + (k + 1)) = *(*(A + i) + k);
                k--;
            }
            *(*(A + i) + (k + 1)) = key;
        }
    }
}


void matrixA(int (*A)[cols], int del) {

    for (int i = 0; i < cols; i++) {
        for (int j = 0; j < cols; j++) {
            cout << *(*(A + i) + j) - del << " ";
        }
        cout << endl;
    }
}

void matrixB(int (*A)[cols], int del) {

    for (int i = 0; i < cols; i++) {
        for (int j = 0; j < cols; j++) {
            cout << *(*(A + i) + j) + del << " ";
        }
        cout << endl;
    }
}

void matrixC(int (*A)[cols], int del) {

    for (int i = 0; i < cols; i++) {
        for (int j = 0; j < cols; j++) {
            cout << *(*(A + i) + j) * del << " ";
        }
        cout << endl;
    }
}

void matrixD(int (*A)[cols], int del) {
    for (int i = 0; i < rows; ++i)
    {
        for (int j = 0; j < cols; ++j) 
        {
            if (A[i][j] > 0)
            {
                float dl = 1.0;
                cout << A[i][j]*dl / del << " ";
            }
            else
            {
                float dl = -1.0;
                cout << A[i][j] * dl / del << " ";
            }
        }
        cout << endl;
    }

}

void idz5(int (*arr)[cols], int (*arr2)[cols]) {
    for (int i = 0; i < cols; i++) {
        for (int j = 0; j < cols; j++) {
            *(*(arr2 + i) + j) = *(*(arr2 + i) + j) - *(*(arr + i) + j);
        }
        cout << endl;
    }
}


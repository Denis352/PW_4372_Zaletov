using namespace std;
const int MAX_SIZE = 100;

struct Stack
{
    char stack[MAX_SIZE];
    int count = -1;
};

struct Stack1 {
    int number;
    Stack1* tail = nullptr;
};

int top(Stack1* token) {
    if (token != nullptr) {
        return token->number;
    }
}

bool empty1(Stack1* token) {
    if (token->tail != nullptr) {
        return 1;
    }
    else {
        return 0;
    }
}

void push(Stack1* token, int value) {
    Stack1 temp;
    Stack1* p = &temp;
    p->tail = token;
    p->number = value;
}

void pop(Stack1* token) {
    if (empty1(token)) {
        free(token);
    }
}

struct Values {
    double arr_values[MAX_SIZE];
    int count = -1;
};

char top(Stack* p) {
    if (p->count >= 0)
        return p->stack[p->count];
    return '\0';
}

double top(Values* p) {
    if (p->count >= 0)
        return p->arr_values[p->count];
    return 0.0;
}

void push(Stack* top, char token) {
    if (top->count < MAX_SIZE - 1) {
        top->count++;
        top->stack[top->count] = token;
    }
    else {
        cout << "Out of range." << endl;
    }
}

void push(Values* top, double token) {
    if (top->count < MAX_SIZE - 1) {
        top->count++;
        top->arr_values[top->count] = token;
    }
    else {
        cout << "Out of range." << endl;
    }
}

int empty(Stack* top) {
    return top->count == -1;
}

int empty(Values* top) {
    return top->count == -1;
}

void pop(Stack* p) {
    if (!empty(p)) {
        p->count--;
    }
    else {
        cout << "Stack is empty." << endl;
    }
}

void pop(Values* p) {
    if (!empty(p)) {
        p->count--;
    }
    else {
        cout << "Stack is empty." << endl;
    }
}


void delay(int milliseconds) {
    this_thread::sleep_for(chrono::milliseconds(milliseconds));
}

int precedence(char op) {
    if (op == '+' || op == '-') return 1;
    if (op == '*' || op == '/') return 2;
    if (op == '^') return 3;
    return 0;
}

void infix_to_postfix(const string& expression, string output[], int& output_size) {
    Stack stack_of_operators;
    Stack* operators = &stack_of_operators;
    istringstream tokens(expression);
    string token;
    output_size = 0;

    while (tokens >> token) {
        if (isdigit(token[0])) {
            output[output_size++] = token;
        }
        else if (token[0] == '(') {
            push(operators, '(');
        }
        else if (token[0] == ')') {
            while (!empty(operators)) {
                char k = top(operators);
                if (k == '(') break;
                output[output_size++] = string(1, k);
                pop(operators);
            }
            if (!empty(operators) && top(operators) == '(') {
                pop(operators);
            }
        }
        else {
            while (!empty(operators) && precedence(top(operators)) >= precedence(token[0])) {
                output[output_size++] = string(1, top(operators));
                pop(operators);
            }
            push(operators, token[0]);
        }
    }

    while (!empty(operators)) {
        output[output_size++] = string(1, top(operators));
        pop(operators);
    }
}

void infix_to_prefix(const string& expression, string output[], int& output_size) {
    string reversed_expression;
    for (int i = expression.length() - 1; i >= 0; i--) {
        if (expression[i] == '(') reversed_expression += ')';
        else if (expression[i] == ')') reversed_expression += '(';
        else reversed_expression += expression[i];
    }

    string temp_output[MAX_SIZE];
    int temp_size;
    infix_to_postfix(reversed_expression, temp_output, temp_size);

    output_size = temp_size;
    for (int i = 0; i < temp_size; i++) {
        output[i] = temp_output[temp_size - 1 - i];
    }
}

void print_stack(Stack* s) {
    cout << "[ ";
    for (int i = 0; i <= s->count; ++i) {
        cout << s->stack[i] << " ";
    }
    cout << "]";
}

void print_values(Values* s) {
    cout << "[ ";
    for (int i = 0; i <= s->count; ++i) {
        cout << s->arr_values[i] << " ";
    }
    cout << "]";
}

double evaluate_notation(const string notation[], int size, bool is_prefix, bool show_steps) {
    Values stack_of_values;
    Values* values = &stack_of_values;

    if (is_prefix) {
        for (int i = size - 1; i >= 0; i--) {
            string token = notation[i];

            if (show_steps) {
                cout << "Processing: " << token << endl;
                cout << "Stack: ";
                print_values(values);
                cout << endl;
                delay(1000);
            }

            if (isdigit(token[0])) {
                push(values, stod(token));

                if (show_steps) {
                    cout << "Pushed " << token << " to stack" << endl;
                    delay(1000);
                }
            }
            else {
                double left = top(values); pop(values);
                double right = top(values); pop(values);
                double result;

                switch (token[0]) {
                case '+': result = left + right; break;
                case '-': result = left - right; break;
                case '*': result = left * right; break;
                case '/': result = left / right; break;
                case '^': result = pow(left, right); break;
                }

                push(values, result);

                if (show_steps) {
                    cout << "Operation: " << left << " " << token << " " << right << " = " << result << endl;
                    cout << "Stack after operation: ";
                    print_values(values);
                    cout << endl;
                    delay(1500);
                }
            }
        }
    }
    else {
        for (int i = 0; i < size; i++) {
            string token = notation[i];

            if (show_steps) {
                cout << "Processing: " << token << endl;
                cout << "Stack: ";
                print_values(values);
                cout << endl;
                delay(1000);
            }

            if (isdigit(token[0])) {
                push(values, stod(token));

                if (show_steps) {
                    cout << "Pushed " << token << " to stack" << endl;
                    delay(1000);
                }
            }
            else {
                double right = top(values); pop(values);
                double left = top(values); pop(values);
                double result;

                switch (token[0]) {
                case '+': result = left + right; break;
                case '-': result = left - right; break;
                case '*': result = left * right; break;
                case '/': result = left / right; break;
                case '^': result = pow(left, right); break;
                }

                push(values, result);

                if (show_steps) {
                    cout << "Operation: " << left << " " << token << " " << right << " = " << result << endl;
                    cout << "Stack after operation: ";
                    print_values(values);
                    cout << endl;
                    delay(1500);
                }
            }
        }
    }

    if (show_steps) {
        cout << "Final result: " << top(values) << endl;
        delay(1000);
    }

    return top(values);
}

bool is_valid_expression(const string& expression) {
    int balance = 0;
    for (char ch : expression) {
        if (ch == '(') balance++;
        if (ch == ')') balance--;
        if (balance < 0) return false;
    }
    return balance == 0;
}

int main() {
    string expression;
    string postfix[MAX_SIZE];
    string prefix[MAX_SIZE];
    int postfix_size, prefix_size;
    cout << "Enter the expression (with spaces between tokens), or enter this: ( 3 + 4 ) * 5. \n";
    getline(cin, expression);

    if (!is_valid_expression(expression)) {
        cout << "Invalid expression: unbalanced parentheses." << endl;
        return 1;
    }

    cout << "Choose notation:\n1) Reverse Polish notation\n2) Direct Polish notation\n> ";
    int choice;
    cin >> choice;

    cout << "Show the solution step by step? (1 - Yes, 0 - No): ";
    bool show_steps;
    cin >> show_steps;

    switch (choice) {
    case 1:
        infix_to_postfix(expression, postfix, postfix_size);
        cout << "Postfix notation: ";
        for (int i = 0; i < postfix_size; i++) {
            cout << postfix[i] << " ";
        }
        cout << endl;
        evaluate_notation(postfix, postfix_size, false, show_steps);
        break;

    case 2:
        infix_to_prefix(expression, prefix, prefix_size);
        cout << "Prefix notation: ";
        for (int i = 0; i < prefix_size; i++) {
            cout << prefix[i] << " ";
        }
        cout << endl;
        evaluate_notation(prefix, prefix_size, true, show_steps);
        break;

    default:
        cout << "Invalid choice." << endl;
        return 1;
    }
    return 0;
}

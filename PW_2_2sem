class Node {
public:
    int data;
    Node* next;
    Node* prev;

    Node(int data) : data(data), next(nullptr), prev(nullptr) {}
};

class DoublyLinkedList {
public:
    Node* head;
    Node* tail;
    int size;

    DoublyLinkedList() : head(nullptr), tail(nullptr), size(0) {}

    ~DoublyLinkedList() {
        while (head) {
            Node* next = head->next;
            delete head;
            head = next;
        }
    }

    void append(int data) {
        Node* newNode = new Node(data);
        if (!head) {
            head = tail = newNode;
        }
        else {
            tail->next = newNode;
            newNode->prev = tail;
            tail = newNode;
        }
        size++;
    }

    void prepend(int data) {
        Node* newNode = new Node(data);
        if (!head) {
            head = tail = newNode;
        }
        else {
            newNode->next = head;
            head->prev = newNode;
            head = newNode;
        }
        size++;
    }

    void insert(int index, int data) {
        if (index < 0 || index > size) {
             cout << "Error: Invalid index. \n" <<  endl;
            return;
        }

        if (index == size) {
            append(data);
            return;
        }

        Node* newNode = new Node(data);
        Node* current = head;
        for (int i = 0; i < index; ++i) {
            current = current->next;
        }

        newNode->next = current;
        newNode->prev = current->prev;
        if (current->prev) {
            current->prev->next = newNode;
        }
        else {
            head = newNode;
        }
        current->prev = newNode;
        size++;
    }

    void removeByIndex(int index) {
        if (index < 0 || index >= size || size == 0) {
             cout << "Error: Invalid index or the list is empty. \n" <<  endl;
            return;
        }

        Node* current = head;
        for (int i = 0; i < index; ++i) {
            current = current->next;
        }

        if (current->prev) {
            current->prev->next = current->next;
        }
        else {
            head = current->next;
        }

        if (current->next) {
            current->next->prev = current->prev;
        }
        else {
            tail = current->prev;
        }

        delete current;
        size--;
    }

    void removeByValue(int value) {
        Node* current = head;
        while (current) {
            if (current->data == value) {
                if (current->prev) {
                    current->prev->next = current->next;
                }
                else {
                    head = current->next;
                }
                if (current->next) {
                    current->next->prev = current->prev;
                }
                else {
                    tail = current->prev;
                }
                Node* temp = current;
                current = current->next;
                delete temp;
                size--;
            }
            else {
                current = current->next;
            }
        }
    }


    int getByIndex(int index) {
        if (index < 0 || index >= size || size == 0) {
             cout << "Error: Invalid index or the list is empty. \n" <<  endl;
            return -1; 
        }
        Node* current = head;
        for (int i = 0; i < index; ++i) {
            current = current->next;
        }
        return current->data;
    }

    void swap(int index1, int index2) {
        if (index1 < 0 || index1 >= size || index2 < 0 || index2 >= size || index1 == index2) {
             cout << "Error: Incorrect indexes or indexes match. \n" <<  endl;
            return;
        }

        Node* node1 = head;
        Node* node2 = head;
        for (int i = 0; i < index1; ++i) {
            node1 = node1->next;
        }
        for (int i = 0; i < index2; ++i) {
            node2 = node2->next;
        }
        int temp = node1->data;
        node1->data = node2->data;
        node2->data = temp;
    }


    void printList() {
        for (Node* current = head; current; current = current->next) {
             cout << current->data << " ";
        }
         cout <<  endl;
    }

    void generateRandomList(int n) {
        srand(time(0));
        for (int i = 0; i < n; ++i) {
            append(rand() % 100);
        }
    }

    void getListFromInput() {
        int data;
        while ( cout << "Enter the element (or -1 to complete):" &&  cin >> data && data != -1) {
            if ( cin.fail()) {
                 cout << "Incorrect input." <<  endl;
                 cin.clear();
                 cin.ignore( numeric_limits< streamsize>::max(), '\n');
                continue;
            }
            append(data);
        }
    }

    template <typename Operation>
    long long measureTime(Operation op, int iterations = 1000) {
        auto start =  chrono::high_resolution_clock::now();
        for (int i = 0; i < iterations; ++i) {
            op();
        }
        auto end =  chrono::high_resolution_clock::now();
        auto duration =  chrono::duration_cast< chrono::microseconds>(end - start);
        return duration.count() / iterations;
    }
};

class DynamicArray {
public:
     vector<int> data;

    DynamicArray() {}

    void append(int value) {
        data.push_back(value);
    }

    void insert(int index, int value) {
        if (index < 0 || index > data.size()) {
             cout << "Error: Invalid index.\n" <<  endl;
            return;
        }
        data.insert(data.begin() + index, value);
    }

    void removeByIndex(int index) {
        if (index < 0 || index >= data.size()) {
             cout << "Error: Invalid index.\n" <<  endl;
            return;
        }
        data.erase(data.begin() + index);
    }


    void removeByValue(int value) {
        data.erase( remove(data.begin(), data.end(), value), data.end());
    }

    int getByIndex(int index) {
        if (index < 0 || index >= data.size()) {
             cout << "Error: Invalid index. \n" <<  endl;
            return -1;
        }
        return data[index];
    }

    void swap(int index1, int index2) {
        if (index1 < 0 || index1 >= data.size() || index2 < 0 || index2 >= data.size() || index1 == index2) {
             cout << "Error: Incorrect indexes or indexes match. \n" <<  endl;
            return;
        }
         swap(data[index1], data[index2]);
    }


    void printArray() {
        for (int value : data) {
             cout << value << " ";
        }
         cout <<  endl;
    }

    void generateRandomArray(int n) {
        srand(time(0));
        data.resize(n);
        for (int i = 0; i < n; ++i) {
            data[i] = rand() % 100;
        }
    }

    void getArrayFromInput() {
        int value;
        while ( cout << "Enter the element (or -1 to complete): \n" &&  cin >> value && value != -1) {
            if ( cin.fail()) {
                 cout << "Incorrect input. \n" <<  endl;
                 cin.clear();
                 cin.ignore( numeric_limits< streamsize>::max(), '\n');
                continue;
            }
            data.push_back(value);
        }
    }

    template <typename Operation>
    long long measureTime(Operation op, int iterations = 1000) {
        auto start =  chrono::high_resolution_clock::now();
        for (int i = 0; i < iterations; ++i) {
            op();
        }
        auto end =  chrono::high_resolution_clock::now();
        auto duration =  chrono::duration_cast< chrono::microseconds>(end - start);
        return duration.count() / iterations;
    }
};


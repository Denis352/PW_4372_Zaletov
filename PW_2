int rrand(int range_min, int range_max) {
	return rand() % (range_max - range_min + 1) + range_min;
}

int binarySearch(int A[], int h, int start, int end) {
	if (end >= start) {
		int mid = start + (end - start) / 2;
		if (A[mid] == h) {
			return mid;
		}
		if (A[mid] > h) {
			return binarySearch(A, h, start, mid - 1);
		}
		return binarySearch(A, h, mid + 1, end);
	}
	return -1;
}

void cocktailSort(int C[], int n) {
	bool swapped = true;
	int start = 0;
	int end = n - 1;

	while (swapped) {
		swapped = false;

		for (int i = start; i < end; ++i) {
			if (C[i] > C[i + 1]) {
				std::swap(C[i], C[i + 1]);
				swapped = true;
			}
		}

		if (!swapped) {
			break;
		}

		swapped = false;
		--end;

		for (int i = end - 1; i >= start; --i) {
			if (C[i] > C[i + 1]) {
				std::swap(C[i], C[i + 1]);
				swapped = true;
			}
		}

		++start;
	}
}

void insertionSort(int E[], int n) {
	int i, key, j;
	for (i = 1; i < n; i++) {
		key = E[i];
		j = i - 1;

		while (j >= 0 && E[j] > key) {
			E[j + 1] = E[j];
			j = j - 1;
		}
		E[j + 1] = key;
	}
}

void quicksort(int* F, int  end, int begin)
{
	int mid;
	int f = begin;
	int l = end;
	mid = F[(f + l) / 2];
	while (f < l)
	{
		while (F[f] < mid) f++;
		while (F[l] > mid) l--;
		if (f <= l)
		{
			swap(F[f], F[l]);
			f++;
			l--;
		}
	}
	if (begin < l) quicksort(F, l, begin);
	if (f < end) quicksort(F, end, f);
}


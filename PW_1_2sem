	for (int i = 0; i < students.size(); i++) {
		if (students[i].sex == "man") {
			mans_count ++;
		}
		else if (students[i].sex == "woman") {
			girls_count ++;
		}
	}

	cout << "Number of men: " << mans_count << "\n";
	cout << "Number of women: " << girls_count << "\n";
}

int student_category_check(const Student& student) {
	for (int i = 0; i < 3; i++) {
		if (student.exam[i] < 4)
			return 1;
		else {
			for (int j = 0; j < 5; j++) {
				if (student.dif_test[j] < 4)
					return 1;
			}
		}
	}

	for (int i = 0; i < 3; i++) {
		if (student.exam[i] > 3 and student.exam[i] < 5)
			return 2;
		else {
			for (int j = 0; j < 5; j++) {
				if (student.exam[j] > 3 and student.exam[j] < 5)
					return 2;
			}
		}
	}

	for (int i = 0; i < 3; i++) {
		if (student.exam[i] == 5)
			return 3;
		else {
			for (int j = 0; j < 5; j++) {
				if (student.exam[j] == 5)
					return 3;
			}
		}
	}
	return 0;
}


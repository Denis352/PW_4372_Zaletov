vector<double> calculate_average_per_session(vector<Student>& students) {
	vector<double> averages;
	for (size_t i = 0; i < students.size(); i++) {
		double sum = 0;
		for (size_t j = 0; j < 3; j++) {
			sum += students[i].exam[j];
		}
		for (size_t j = 0; j < 5; j++) {
			sum += students[i].dif_test[j];
		}
		averages.push_back(sum / 8.0);
	}
	return averages;
}

bool compare_pairs(const pair<double, Student>& a, const pair<double, Student>& b) {
	return a.first > b.first;
}

void print_top_students(const vector<Student>& students, const vector<double>& averages) {
	if (students.empty()) {
		cout << "The list of students is empty.\n";
		return;
	}

	vector<pair<double, Student>> student_average_pairs;
	for (size_t i = 0; i < students.size(); i++) {
		student_average_pairs.push_back({ averages[i], students[i] });
	}

	sort(student_average_pairs.begin(), student_average_pairs.end(), compare_pairs);

	cout << "Top 3 students with the highest average score:\n";
	for (int i = 0; i < 3; i++) {
		const auto& student = student_average_pairs[i].second;
		double average = student_average_pairs[i].first;
		cout << "\n" << "Student №" << i + 1 << "\n";
		cout << "Full name: " << student.fio << "\n";
		cout << "Group number: " << student.group << "\n";
		cout << "Average score: " << average << "\n";
	}
}

void print_gender_stud(const vector<Student>& students) {

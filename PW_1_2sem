void create_new_inf_book(const vector<Student>& students, vector<library>& books, int st, int bk) {
	if (bk > 0 && bk <= books.size() && st > 0 && st <= students.size()) {
		books[bk - 1].stud_numb = students[st - 1].lib_ticket;
		save_inf_in_file_idz(books, "library.txt");
	}
	else {
		cout << "Incorrect data\n";
	}
}
void book_delivery_idz(vector<library>& books, int bk) {
	if (bk > 0 && bk <= books.size()) {
		books[bk - 1].stud_numb = 0;
		save_inf_in_file_idz(books, "library.txt");
	}
	else {
		cout << "Incorrect data\n";
	}
}

void save_inf_in_file(const vector<Student>& students, const string& filename) {
	ofstream file(filename);
	for (size_t i = 0; i < students.size(); i++) {
		const auto& student = students[i];
		file << student.fio << "\n";
		file << student.sex << "\n";
		file << student.group << "\n";
		file << student.numb << "\n";
		file << student.lib_ticket << "\n";
		for (size_t i = 0; i < 3; i++) {
			file << student.exam[i] << " ";
		}
		file << "\n";
		for (size_t i = 0; i < 5; i++) {
			file << student.dif_test[i] << " ";
		}
		file << "\n";
	}
	file.close();
}

vector<Student> load_inf_from_file(const string& filename) {
	vector<Student> students;
	ifstream file(filename);
	Student student;
	while (getline(file, student.fio) &&
		getline(file, student.sex)) {
		file >> student.group >> student.numb >> student.lib_ticket;
		for (size_t i = 0; i < 3; i++) {
			file >> student.exam[i];
		}
		for (size_t i = 0; i < 5; i++) {
			file >> student.dif_test[i];
		}
		file.ignore(numeric_limits<streamsize>::max(), '\n');
		students.push_back(student);
	}
	file.close();
	return students;
}

